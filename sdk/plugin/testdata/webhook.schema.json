{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "auth": {
      "additionalProperties": false,
      "properties": {
        "realm": {
          "type": "string"
        },
        "token": {
          "type": "string",
          "x-aiops-tenant": true,
          "x-aiops-volatile": true
        }
      },
      "type": "object"
    },
    "burst": {
      "maximum": 2147483647,
      "minimum": -2147483648,
      "type": "integer"
    },
    "headers": {
      "additionalProperties": {
        "type": "string",
        "x-aiops-volatile": true
      },
      "type": "object"
    },
    "ratio": {
      "maximum": 3.4028234663852886e+38,
      "minimum": -3.4028234663852886e+38,
      "type": "number"
    },
    "retries": {
      "default": 3,
      "maximum": 255,
      "minimum": 0,
      "type": "integer"
    },
    "rules": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "until": {
            "pattern": "^[-+]?(0|(([0-9]+(\\.[0-9]*)?|\\.[0-9]+)(ns|us|µs|μs|ms|s|m|h))+)$",
            "type": "string",
            "x-aiops-volatile": true
          }
        },
        "type": "object"
      },
      "type": "array"
    },
    "timeout": {
      "default": "5s",
      "pattern": "^[-+]?(0|(([0-9]+(\\.[0-9]*)?|\\.[0-9]+)(ns|us|µs|μs|ms|s|m|h))+)$",
      "type": "string"
    },
    "url": {
      "type": "string",
      "x-aiops-tenant": true,
      "x-aiops-volatile": true
    },
    "windows": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "until": {
            "pattern": "^[-+]?(0|(([0-9]+(\\.[0-9]*)?|\\.[0-9]+)(ns|us|µs|μs|ms|s|m|h))+)$",
            "type": "string",
            "x-aiops-volatile": true
          }
        },
        "type": "object"
      },
      "type": "array",
      "x-aiops-tenant": true,
      "x-aiops-volatile": true
    }
  },
  "type": "object"
}

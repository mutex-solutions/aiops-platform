# aiopsctl profile render --dump-hooks
digest sha256:ae4a388b950cc345cccbc1a6617f63f4e04f8969012d3a2b377dd4b32a618f86
roles all

hook composition/applied
  1. stage 0 (default) plugin aiops/readiness row readiness

hook internal/config sealed to aiops/config-refs
  1. stage 0 (default) plugin aiops/config-refs row refs

hook internal/status sealed to aiops/readiness, aiops/restart-policy
  1. stage 0 (default) plugin aiops/readiness row readiness
  2. stage 0 (default) plugin aiops/restart-policy row restart-policy

hook reload/operation
  1. stage 0 (default) plugin aiops/readiness row readiness
  2. stage 0 (default) plugin aiops/restart-policy row restart-policy

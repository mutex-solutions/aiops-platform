{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "clock": {
      "additionalProperties": false,
      "properties": {},
      "type": "object",
      "x-aiops-plugin": "aiops/clock"
    },
    "consumer": {
      "additionalProperties": false,
      "properties": {
        "applyDelay": {
          "pattern": "^[-+]?(0|(([0-9]+(\\.[0-9]*)?|\\.[0-9]+)(ns|us|µs|μs|ms|s|m|h))+)$",
          "type": "string"
        },
        "callEvery": {
          "pattern": "^[-+]?(0|(([0-9]+(\\.[0-9]*)?|\\.[0-9]+)(ns|us|µs|μs|ms|s|m|h))+)$",
          "type": "string"
        },
        "callHold": {
          "pattern": "^[-+]?(0|(([0-9]+(\\.[0-9]*)?|\\.[0-9]+)(ns|us|µs|μs|ms|s|m|h))+)$",
          "type": "string"
        },
        "note": {
          "type": "string",
          "x-aiops-volatile": true
        },
        "tag": {
          "type": "string",
          "x-aiops-volatile": true
        }
      },
      "type": "object",
      "x-aiops-plugin": "aiops-test/toy-consumer",
      "x-aiops-volatile": [
        "config.note",
        "config.tag"
      ]
    },
    "loader": {
      "x-aiops-plugin": "aiops/loader"
    },
    "readiness": {
      "additionalProperties": false,
      "properties": {},
      "type": "object",
      "x-aiops-plugin": "aiops/readiness"
    },
    "refs": {
      "additionalProperties": false,
      "properties": {
        "maxFileBytes": {
          "type": "integer"
        }
      },
      "type": "object",
      "x-aiops-plugin": "aiops/config-refs"
    },
    "reload": {
      "additionalProperties": false,
      "properties": {
        "history": {
          "type": "integer"
        },
        "queue": {
          "type": "integer"
        }
      },
      "type": "object",
      "x-aiops-plugin": "aiops/reload"
    },
    "restart-policy": {
      "additionalProperties": false,
      "properties": {
        "backoffMax": {
          "pattern": "^[-+]?(0|(([0-9]+(\\.[0-9]*)?|\\.[0-9]+)(ns|us|µs|μs|ms|s|m|h))+)$",
          "type": "string"
        },
        "backoffMin": {
          "pattern": "^[-+]?(0|(([0-9]+(\\.[0-9]*)?|\\.[0-9]+)(ns|us|µs|μs|ms|s|m|h))+)$",
          "type": "string"
        },
        "factor": {
          "type": "integer"
        },
        "infrastructure": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "maxFailures": {
          "type": "integer"
        },
        "stable": {
          "pattern": "^[-+]?(0|(([0-9]+(\\.[0-9]*)?|\\.[0-9]+)(ns|us|µs|μs|ms|s|m|h))+)$",
          "type": "string"
        },
        "window": {
          "pattern": "^[-+]?(0|(([0-9]+(\\.[0-9]*)?|\\.[0-9]+)(ns|us|µs|μs|ms|s|m|h))+)$",
          "type": "string"
        }
      },

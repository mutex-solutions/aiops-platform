# One job that runs the check of the platform on this plugin (07-c4-plugin-sdk.md:1559).
# Put on PATH the aiopsctl of the release the plugin is built against: the check runs
# step 7 against the release that aiopsctl was built from.
name: check

on:
  push:
  pull_request:

permissions:
  contents: read

jobs:
  check:
    runs-on: ubuntu-24.04
    timeout-minutes: 30
    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4
{{- if ne .Registry "connector"}}
      - uses: actions/setup-go@40f1582b2485089dde7abd97c1529aa768e1baff # v5
        with:
          go-version: "1.26.8"
{{- end}}
      - name: plugin check
        run: aiopsctl plugin check ./

// Package {{.Package}} is the plugin {{.ID}}: an echoer, a contribution to the echoers
// registry (sdk/def/echoers/v0). The echoer itself is in internal/echo.
package {{.Package}}

import (
	echoers "github.com/mutex-solutions/aiops-platform/sdk/def/echoers/v0"
	"github.com/mutex-solutions/aiops-platform/sdk/kernel"
	"github.com/mutex-solutions/aiops-platform/sdk/plugin"

	"{{.Module}}/internal/echo"
)

// ID is the plugin id.
const ID = "{{.ID}}"

// Config is the row config; plugin check --write derives its schema.
type Config struct {
	// Name is the name the echoer registers under.
	Name string `default:"{{.Name}}"`
}

// Plugin is the plugin: it registers one echoer under the name of its config.
var Plugin = plugin.Define(plugin.Spec[Config]{
	ID:        ID,
	Inject:    []kernel.Dep{kernel.Need(echoers.Key)},
	Registers: []kernel.AnyKey{echoers.Key},
	Apply: func(c *kernel.Context, cfg *Config) error {
		return echoers.Key.Of(c).Register(c, cfg.Name, echo.New(c))
	},
})

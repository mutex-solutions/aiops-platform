{
  "schema": "s0-script/v1",
  "id": "D06",
  "title": "Inherited committed injection and explicit required lookup are distinct",
  "covers": [
    "inherited-inject-in-realm"
  ],
  "plugins": [
    {
      "id": "provider",
      "apply": [
        {
          "op": "provide",
          "key": "svc",
          "value": "outer"
        }
      ]
    },
    {
      "id": "parent",
      "apply": [
        {
          "op": "child",
          "fiber": "child",
          "plugin": "child",
          "config": {}
        },
        {
          "op": "context",
          "mode": "isolate",
          "to": "private",
          "key": "svc",
          "label": "child-private"
        },
        {
          "op": "child",
          "context": "private",
          "fiber": "private-child",
          "plugin": "private-child",
          "config": {}
        },
        {"op": "child", "context": "private", "fiber": "private-required", "plugin": "private-required", "config": {}}
      ],
      "needs": {
        "svc": null
      }
    },
    {
      "id": "child",
      "apply": [
        {
          "op": "read",
          "key": "svc",
          "to": "inherited"
        }
      ]
    },
    {
      "id": "private-child",
      "apply": [
        {
          "op": "read",
          "key": "svc",
          "to": "retained-inherited",
          "catch": true
        }
      ]
    },
    {"id": "private-required", "needs": {"svc": null}, "apply": [{"op": "read", "key": "svc", "to": "must-stay-pending"}]}
  ],
  "steps": [
    {
      "op": "mount",
      "fiber": "provider",
      "plugin": "provider",
      "config": {}
    },
    {
      "op": "mount",
      "fiber": "parent",
      "plugin": "parent",
      "config": {}
    },
    {
      "op": "settle",
      "label": "children"
    },
    {
      "op": "dispose",
      "fiber": "parent"
    },
    {
      "op": "dispose",
      "fiber": "provider"
    },
    {
      "op": "settle",
      "label": "disposed"
    }
  ],
  "expect": [
    {
      "at": "children",
      "path": "/outputs/inherited",
      "equals": "outer"
    },
    {
      "at": "children",
      "path": "/outputs/retained-inherited",
      "equals": "outer"
    },
    {"at": "children", "path": "/states/4/state", "equals": "PENDING"}
  ]
}

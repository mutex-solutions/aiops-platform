{
 "schema": "s0-script/v1",
 "id": "D97",
 "title": "Parent disposal joins child and late effect cleanup",
 "covers": [
  "child-teardown",
  "late-disposer-join"
 ],
 "plugins": [
  {
   "id": "parent",
   "apply": [
    {
     "op": "child",
     "fiber": "child",
     "plugin": "child",
     "config": {}
    },
    {
     "op": "mark",
     "label": "child-mounted"
    }
   ],
   "cleanup": [
    {
     "op": "mark",
     "label": "parent-cleanup"
    }
   ]
  },
  {
   "id": "child",
   "apply": [
    {
     "op": "effect",
     "label": "late-setup",
     "program": [
      {
       "op": "gate",
       "label": "effect-setup"
      }
     ],
     "cleanup": [
      {
       "op": "gate",
       "label": "effect-cleanup"
      },
      {
       "op": "mark",
       "label": "effect-cleaned"
      }
     ],
     "await": false
    }
   ]
  },
  {
   "id": "o",
   "apply": [],
   "cleanup": [
    {
     "op": "mark",
     "label": "o-cleanup"
    }
   ]
  }
 ],
 "steps": [
  {
   "op": "mount",
   "fiber": "o",
   "plugin": "o",
   "config": {}
  },
  {
   "op": "mount",
   "fiber": "parent",
   "plugin": "parent",
   "config": {}
  },
  {
   "op": "waitMark",
   "label": "effect-setup"
  },
  {
   "op": "waitMark",
   "label": "child-mounted"
  },
  {
   "op": "awaitFiber",
   "fiber": "child"
  },
  {
   "op": "awaitFiber",
   "fiber": "parent"
  },
  {
   "op": "awaitFiber",
   "fiber": "o"
  },
  {
   "op": "dispose",
   "fiber": "parent",
   "await": false,
   "task": "parent-dispose"
  },
  {
   "op": "snapshot",
   "label": "joining-setup"
  },
  {
   "op": "dispose",
   "fiber": "o"
  },
  {
   "op": "release",
   "label": "effect-setup"
  },
  {
   "op": "waitMark",
   "label": "effect-cleanup"
  },
  {
   "op": "snapshot",
   "label": "joining-cleanup"
  },
  {
   "op": "release",
   "label": "effect-cleanup"
  },
  {
   "op": "settle",
   "label": "disposed"
  }
 ],
 "expect": [],
 "attribution": [
  "https://github.com/deepseek-ai/deepseek-harness/blob/fcc0ad462172522aaf5c93a7b2e01f6b9f0b0159/packages/extensions/tool-cordis/tests/cordis-lifecycle.spec.ts"
 ]
}
  "cards": [
    {
      "dot": "cyan",
      "title": "One process",
      "items": [
        "aiops --role all mounts every row of this slice for the tenant default",
        "A first install runs no on-call container and no harness container",
        "Pages leave through notifications: notifier-email and notifier-webhook"
      ]
    },
    {
      "dot": "amber",
      "title": "Dead-man",
      "items": [
        "Watchdog reaches the kernel every minute with the alert webhooks",
        "platform-page-path goes straight to the platform-health receiver, not through the kernel"
      ]
    },
    {
      "dot": "slate",
      "title": "Optional",
      "items": [
        "Slack only with the bundle aiops-chatops-slack: outbound Socket Mode and Web API, no inbound",
        "oncall-engine only with an external provider plugin and a chart or compose value that is off by default"
      ]
    },
    {
      "dot": "violet",
      "title": "aiops-only",
      "items": [
        "The same process without metrics-store: the customer own systems send the alerts",
        "aiops-oncall is composed; with no policy bound the timeline says so"
      ]
    }
  ]

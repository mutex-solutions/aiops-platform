{"schema_version":1,"diagram_type":"architecture","meta":{"title":"Value types a contribution and its dispatcher share","locale":"en","quality_profile":"showcase","legend":{"entries":{"backend":{"label":"Value type"},"database":{"label":"Stored by first-party plugin"},"frontend":{"label":"Contribution"}}}},"layout":{"mode":"grid","origin":[60,120],"cols":5,"gapX":110,"gapY":110,"cellW":160,"cellH":64},"components":[{"id":"EntityRef","type":"backend","label":"EntityRef","sublabel":"entity.Ref, kind:id","row":1,"col":0,"size":[160,64]},{"id":"Signal","type":"backend","label":"Signal","sublabel":"returned by Parse","row":0,"col":1,"size":[160,64]},{"id":"StoredSignal","type":"database","label":"StoredSignal","sublabel":"signal_core.signal","row":0,"col":2,"size":[160,64]},{"id":"PlanRequest","type":"backend","label":"PlanRequest","sublabel":"typed action, target","row":1,"col":1,"size":[160,64]},{"id":"Executor","type":"frontend","label":"Executor","sublabel":"executors contribution","row":1,"col":2,"size":[160,64]},{"id":"Readback","type":"backend","label":"Readback","sublabel":"state, not verdict","row":1,"col":3,"size":[160,64]},{"id":"Verdict","type":"database","label":"Verdict","sublabel":"set by change-hub","row":1,"col":4,"size":[160,64]},{"id":"TenantLimits","type":"database","label":"TenantLimits","sublabel":"per pillar and kind","row":2,"col":1,"size":[160,64]},{"id":"Budget","type":"backend","label":"Budget","sublabel":"steps, tokens, deadline","row":2,"col":2,"size":[160,64]},{"id":"Harness","type":"frontend","label":"Harness","sublabel":"harnesses contribution","row":2,"col":3,"size":[160,64]}],"boundaries":[{"kind":"region","label":"Parsed signal","wraps":["Signal","StoredSignal"]},{"kind":"region","label":"Read-back and verdict","wraps":["PlanRequest","Executor","Readback","Verdict"]},{"kind":"region","label":"Run budget","wraps":["TenantLimits","Budget","Harness"]}],"connections":[{"id":"plan-executor","from":"PlanRequest","to":"Executor","label":"passed to Plan","variant":"emphasis"},{"id":"executor-readback","from":"Executor","to":"Readback","label":"Verify returns","variant":"emphasis"},{"id":"readback-verdict","from":"Readback","to":"Verdict","label":"change-hub maps","variant":"emphasis"},{"id":"plan-entityref","from":"PlanRequest","to":"EntityRef","label":"target is","labelDx":-12},{"id":"signal-entityref","from":"Signal","to":"EntityRef","label":"names targets","fromSide":"left","toSide":"top"},{"id":"signal-stored","from":"Signal","to":"StoredSignal","label":"stored as"},{"id":"limits-budget","from":"TenantLimits","to":"Budget","label":"agent-runs reads"},{"id":"budget-harness","from":"Budget","to":"Harness","label":"in the request"}],"cards":[{"dot":"cyan","title":"Set by the dispatcher side, never by a contribution","items":["signal_type is set by signal-core on signal/normalize","correlation_key is set by correlate and is itself an entity reference"]},{"dot":"emerald","title":"Run budget","items":["Steps, tool calls, input and output tokens, a deadline and a wrap-up time, each in its own unit; USD is information only","Enforced at the two views the harness holds, the tool set and the model view with llm-gateway, never from the stream it reports","Run slots are not a field: agent-runs takes a slot lease and a budget lease from limiter before the run"]},{"dot":"violet","title":"Verdict words","items":["cleared, still_present, failed, uncertain","An executor returns applied, not_applied or unreadable and never a verdict word"]}]}

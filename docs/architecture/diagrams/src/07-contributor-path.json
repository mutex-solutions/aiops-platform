  "cards": [
    {
      "dot": "cyan",
      "title": "Easy to start",
      "items": [
        "A new plugin compiles and passes T0 and the generated tests at once",
        "Its conformance run fails with one line per obligation, and that list is the work list"
      ]
    },
    {
      "dot": "emerald",
      "title": "One command before a pull request",
      "items": [
        "aiopsctl plugin check ./ replays the fixtures, so CI needs no vendor credential",
        "Nobody needs a kernel checkout; a pack with no code needs no SDK and no toolchain"
      ]
    },
    {
      "dot": "violet",
      "title": "Two ways to share",
      "items": [
        "contrib/<name>/ in this repository: maintainers review, CI runs its suites, the row ships disabled",
        "An index entry: the author keeps the code and the release rhythm"
      ]
    }
  ]

 "cards": [
  {
   "dot": "rose",
   "title": "Authority stays in the plugins",
   "items": [
    "The surface authorises nothing; approval counts quorum on platform users",
    "Approving needs a Sign in with Slack link",
    "remediation is the only caller of an executor and refuses Apply without a ChangeToken"
   ]
  },
  {
   "dot": "cyan",
   "title": "Notices",
   "items": [
    "notifications scrubs, runs the notify/pre-send gate, digests and paces, then calls notifier-slack",
    "Events are rendered after commit, ordered per tenant; digest-only in storm mode"
   ]
  }
 ]

 "cards": [
  {
   "dot": "cyan",
   "title": "Who calls a provider",
   "items": [
    "Only paging calls a provider row: the page job, the ack entries and the periodic jobs are parts of it or go through it",
    "Readers of who is on call get the cache and never wait on a provider",
    "The page path has no hook, and a page notification passes no gate, digest or pacing"
   ]
  },
  {
   "dot": "amber",
   "title": "Dead-man",
   "items": [
    "Watchdog enters signal-core every minute, opens no incident and beats the end-to-end monitor through paging",
    "platform-page-path goes from the alert router to the platform-health receiver and never crosses the kernel",
    "Providers never receive other alert webhooks"
   ]
  },
  {
   "dot": "slate",
   "title": "Provider",
   "items": [
    "on-call-provider-builtin is first-party and runs in the kernel process: no engine and no carrier client",
    "It is the default under working assumption W11",
    "An external provider plugin is one more optional contribution behind paging"
   ]
  }
 ]

 "cards": [
  {
   "dot": "cyan",
   "title": "Only the dispatcher calls",
   "items": [
    "A contribution is registered with the registry and provided under no key",
    "The guard is a deadline, a concurrency cap and a breaker per (tenant, row), an Enter lease, the invariant, then the call"
   ]
  },
  {
   "dot": "rose",
   "title": "Fail closed",
   "items": [
    "The dispatcher of an effectful operation injects pii, approval, changes, credentials and audit",
    "Without them it does not exist"
   ]
  },
  {
   "dot": "violet",
   "title": "Two halves",
   "items": [
    "The obligations half is what a contribution owes and is what aiopsctl plugin check runs",
    "The guard half is what the dispatcher owes and runs against the real dispatcher and the fake"
   ]
  }

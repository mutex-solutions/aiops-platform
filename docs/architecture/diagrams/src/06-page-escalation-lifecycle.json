  "cards": [
    {
      "dot": "emerald",
      "title": "Who moves a page",
      "items": [
        "paging writes the page row and calls Page once per incident",
        "Each escalation step is a durable job of the built-in provider; a step job that fires twice sends once",
        "Ack through any entry (link, API, aiopsctl, chat button) stops the pending steps"
      ]
    },
    {
      "dot": "amber",
      "title": "No ack",
      "items": [
        "After the last repeat of the last step the page is unacknowledged and the timeline shows it",
        "Steps that came due while the kernel was down fire when it returns"
      ]
    },
    {
      "dot": "slate",
      "title": "Status of this model",
      "items": [
        "A reading of the harness record; ADR-055 fixes it",
        "No code before the owner chooses the built-in provider and LAWYER Q3 is answered"
      ]
    }
  ]

 "cards": [
  {
   "dot": "cyan",
   "title": "Epoch",
   "items": [
    "Derived from the fiber's revision and the uid of the provision bound to each Need",
    "A provider swap changes the uid, so every consumer restarts in place",
    "A fiber is ACTIVE only for the epoch it loaded with"
   ]
  },
  {
   "dot": "amber",
   "title": "Unload",
   "items": [
    "Quiesce first: Std() cancelled, no new leases or effects, open Enter leases and tracked goroutines drain",
    "Then disposers run last in, first out, each under the dispose deadline"
   ]
  },
  {
   "dot": "rose",
   "title": "Failure",
   "items": [
    "FAILED is sticky and the kernel module never retries",
    "A dependency change does not retry it",
    "restart-policy calls Update with its own backoff"
   ]
  }
 ]

 "cards": [
  {
   "dot": "cyan",
   "title": "Receive",
   "items": [
    "The ack follows one durable insert of the unique turn job",
    "The surface resolves the tenant from its installation record and chat mints the handle, never from the payload"
   ]
  },
  {
   "dot": "emerald",
   "title": "Turn and answer",
   "items": [
    "agent-runs selects the harness, takes the leases and writes every step before it forwards it",
    "The default harness is harness-native; an optional harness runs behind agent-runs in the same way",
    "chat scrubs every text before a surface is called"
   ]
  },
  {
   "dot": "slate",
   "title": "Optional surface",
   "items": [
    "The Slack rows are in the bundle aiops-chatops-slack, which no shipped profile lists",
    "With no chat surface a question enters through ask-api"
   ]
  }
 ]

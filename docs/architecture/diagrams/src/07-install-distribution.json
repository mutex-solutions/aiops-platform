{"schema_version":2,"diagram_type":"workflow","meta":{"title":"Install and distribution for both runtimes","locale":"en","quality_profile":"showcase","legend":{"mode":"auto","entries":{"external":{"label":"plugin author"},"database":{"label":"artifacts and site files"},"backend":{"label":"commands"},"cloud":{"label":"runtime unit"}}}},"lanes":[{"id":"policy","label":"Site trust policy"},{"id":"install","label":"Publish and install; remote plugins and packs end here"},{"id":"rebuild","label":"In-process Go outside a release image: build first"}],"mainPath":["Publisher","Artifact","Install","Lock","Unit","Enable"],"nodes":[{"id":"Publisher","lane":"install","col":0,"width":124,"height":64,"type":"external","label":"Plugin author","sublabel":"pack, sign, push"},{"id":"Artifact","lane":"install","col":1,"width":140,"height":64,"type":"database","label":"Plugin artifact","sublabel":"OCI, by digest"},{"id":"Install","lane":"install","col":2,"width":138,"height":64,"type":"backend","label":"plugin install","sublabel":"gate, no code runs"},{"id":"Lock","lane":"install","col":3,"width":128,"height":64,"type":"database","label":"plugins.lock","sublabel":"bundle added, disabled"},{"id":"Unit","lane":"install","col":4,"width":140,"height":64,"type":"cloud","label":"Deployment unit","sublabel":"starts remote instance"},{"id":"Enable","lane":"install","col":5,"width":130,"height":64,"type":"backend","label":"plugin enable","sublabel":"reload queue submission"},{"id":"Trust","lane":"policy","col":2,"width":140,"height":64,"type":"database","label":"trust.yaml","sublabel":"signers, distribution keys"},{"id":"DistYaml","lane":"rebuild","col":2,"width":140,"height":64,"type":"database","label":"dist.yaml","sublabel":"plugins, bindings, licences"},{"id":"Builder","lane":"rebuild","col":3,"width":112,"height":64,"type":"backend","label":"dist build","sublabel":"builder image"},{"id":"DistSign","lane":"rebuild","col":4,"width":108,"height":64,"type":"backend","label":"dist sign","sublab
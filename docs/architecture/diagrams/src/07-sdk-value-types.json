 "cards": [
  {
   "dot": "cyan",
   "title": "Declared as data",
   "items": [
    "Inject, Provides, Hooks and Durable are data, so profile render finds cycles and missing or duplicate providers before boot",
    "plugingen writes the generated half of plugin.yaml and CI fails on a difference"
   ]
  },
  {
   "dot": "emerald",
   "title": "Key classes",
   "items": [
    "NewKey is called only in a definition package",
    "Provide on a provider-bound key and resolution of a consumer-bound key succeed only for a module-table entry the binding map lists",
    "kerneltest is the only constructor with both maps off"
   ]
  },
  {
   "dot": "violet",
   "title": "Tenant",
   "items": [
    "The handle travels in the call's context",
    "EnqueueTx and EmitTx stamp the tenant from Tx.Tenant(), never from an argument"
   ]
  }
 ]

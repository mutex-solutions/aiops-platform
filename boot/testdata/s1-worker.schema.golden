          "type": "integer",
          "x-aiops-volatile": true
        }
      },
      "type": "object",
      "x-aiops-plugin": "aiops/tool-search",
      "x-aiops-volatile": [
        "config.auth.token",
        "config.timeout"
      ]
    }
  },
